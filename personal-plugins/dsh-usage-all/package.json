{
  "name": "dsh-usage-all",
  "version": "1.0.0",
  "private": true,
  "description": "自维护用量一体化插件：徽章+官方额度+事件账本+看板（会话/供应商/模型/日周月）+5h窗口+余额，fork合并不随官方更新",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./client-rings": "./lib/client-rings.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}