{
  "name": "dsh-usage-board",
  "description": "自维护用量看板：会话/供应商/模型/日周月统计、5h窗口、峰谷、余额充值（fork of @skkjkk/dsh-usage-dashboard，不随官方更新）",
  "version": "0.3.8",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./usage": "./lib/index.js",
    "./detail": "./lib/index.js",
    "./calendar": "./lib/index.js"
  },
  "scripts": {
    "build": "node scripts/regenerate.cjs",
    "bench": "node scripts/bench.js",
    "smoke": "npm run build && node scripts/smoke-host.mjs",
    "test": "npm run build && npm run bench && node scripts/smoke-host.mjs",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "private": true
}