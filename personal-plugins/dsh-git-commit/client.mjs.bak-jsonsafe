  var hide = document.createElement('style');
  hide.textContent = '#dsh-git-commit-chip{visibility:hidden!important;pointer-events:none!important}[data-gitgraph-chip-anchor]{visibility:hidden!important;pointer-events:none!important}[data-gitgraph-chip]{visibility:hidden!important;pointer-events:none!important}';
  hide.textContent += '#' + ID + ' button{outline:none}#' + ID + ' button:focus-visible{box-shadow:0 0 0 2px var(--dsw-alias-brand-primary,#4c8dff)}#' + ID + ' button:hover{filter:brightness(1.18)}';
  hide.textContent += '.gb-pop{position:fixed;z-index:2147483002;background:var(--dsw-alias-bg-layer-2,#101a30);border:1px solid rgba(168,200,232,.25);border-radius:10px;box-shadow:0 12px 32px rgba(0,0,0,.45);font-size:12.5px;color:var(--dsw-alias-label-primary,#dfe8f8);padding:10px;animation:gbIn .12s ease-out}@keyframes gbIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}';
  hide.textContent += '.gb-row{display:flex;gap:8px;align-items:center;padding:4px 8px;border-radius:6px;cursor:pointer}.gb-row:hover{background:rgba(76,141,255,.14)}.gb-cur{background:rgba(76,141,255,.22)}';
  document.head.appendChild(hide);
  var st = { cwd: '', branch: '', dirty: 0, branches: [], host: null };
  var JJ = function(r){ return r.json().catch(function(){ return null; }); };
  // ---------- cwd 解析（fiber sessionId → session.list）----------
  var selId = function(){
    var sel = document.querySelector('[role="treeitem"][aria-selected="true"], [role="treeitem"][data-selected]');
    if (!sel) return null;
    var fk = null; for (var k in sel) if (k.indexOf('__reactFiber') === 0) { fk = k; break; }
    if (!fk) return null;
    var f = sel[fk];
    for (var i = 0; i < 8 && f; i++) {
      var p = f.memoizedProps;
      if (p && typeof p === 'object' && p.node && p.node.id) return String(p.node.id);
      f = f.return;
    }
    return null;
  };
  var resolveCwd = async function(){
    if (st.cwd) return;
    var cands = [];
    try {
      var sel = document.querySelector('[role="treeitem"][aria-selected="true"], [role="treeitem"][data-selected]');
      if (sel) {
        var fk = null; for (var k in sel) if (k.indexOf('__reactFiber') === 0) { fk = k; break; }
        if (fk) {
          var f = sel[fk];
          for (var i = 0; i < 8 && f; i++) {
            var p = f.memoizedProps;
            if (p && p.node && typeof p.node === 'object') {
              ['cwd', 'workdir', 'workDir', 'path', 'dir'].forEach(function(kk) { if (p.node[kk] && typeof p.node[kk] === 'string' && p.node[kk].indexOf('/') === 0) cands.push(p.node[kk]); });
            }
            f = f.return;
          }
        }
      }
    } catch (e) {}
    try { var txt = document.body.innerText || ''; var mm = txt.match(/\/Users\/[\w\u4e00-\u9fff\/\-\.]{4,90}/g) || []; cands = cands.concat(mm); } catch (e) {}
    for (var c = 0; c < cands.length && c < 14; c++) {
      var d = cands[c];
      try {
        var r = await fetch('/api/dsh-git-commit/status?cwd=' + encodeURIComponent(d));
        if (r.ok) { var j = await r.json(); if (j && j.ok) { st.cwd = d; return; } }
      } catch (e) {}
    }
  };
  // ---------- host 发现（图谱用）----------
  var findHost = function(){
    if (st.host !== null) return st.host;
    var a = document.querySelector('[data-gitgraph-chip-anchor]');
    if (!a) return null;
    for (var k in a) {
      if (k.indexOf('__reactFiber') === 0) {
        var f = a[k];
        for (var i = 0; i < 30 && f; i++) {
          try {
            var p = f.memoizedProps;
            if (p && typeof p === 'object') {
              var s = '';
              try { s = JSON.stringify(p); } catch (e) { s = ''; }
              var m = s && s.match(/https?:\/\/127\.0\.0\.1:\d+/);
              if (m) { st.host = m[0]; return st.host; }
              var h = p.host || p.baseUrl || p.endpoint;
              if (typeof h === 'string' && h.indexOf('http') === 0) { st.host = h; return h; }
            }
          } catch (e) {}
          f = f.return;
        }
      }
    }
    return null;
  };
  // ---------- 数据刷新 ----------
  var refresh = async function(){
    if (!st.cwd) await resolveCwd();
    if (!st.cwd) return;
    try {
      var s0 = await JJ(await fetch('/api/dsh-git-commit/status?cwd=' + encodeURIComponent(st.cwd)));
      var s = s0 && s0.ok ? s0.status : (s0 || null);
      if (s) {
        st.branch = s.branch || s.current || s.head || st.branch || '';
        st.dirty = (s.untracked || 0) + ((s.staged && s.staged.n) || 0) + ((s.unstaged && s.unstaged.n) || 0);
      }
    } catch (e) {}
    var bl = document.getElementById(ID + '-bl'); if (bl) bl.textContent = st.branch || '⎇';
    var cb = document.getElementById(ID + '-commit'); if (cb) cb.textContent = '⎇ 提交' + (st.dirty ? '±' + st.dirty : '');
  };
  var loadBranches = async function(){
    if (!st.cwd) await resolveCwd();
    if (!st.cwd) return [];
    try {
      var b0 = await JJ(await fetch('/api/dsh-git-commit/branches?cwd=' + encodeURIComponent(st.cwd)));
      var b = b0 && b0.ok ? (b0.branches || b0.list || b0.status) : b0;
      var arr = (b && (b.branches || b.list || b)) || [];
      st.branches = Array.isArray(arr) ? arr.map(function(x){ return typeof x === 'string' ? x : (x.name || x.branch || ''); }).filter(Boolean) : [];
    } catch (e) { st.branches = []; }
    return st.branches;
  };
  // ---------- 弹层框架 ----------
  var openPop = function(anchor, id, w){
    closePops();
    var p = document.createElement('div');
    p.id = id; p.className = 'gb-pop';
    var r = anchor.getBoundingClientRect();
    p.style.left = Math.max(8, Math.min(window.innerWidth - w - 12, Math.round(r.left))) + 'px';
    p.style.top = Math.round(r.bottom + 6) + 'px';
    p.style.width = w + 'px';
    p.style.maxHeight = '62vh';
    p.style.overflow = 'auto';
    document.body.appendChild(p);
    return p;
  };
  var closePops = function(){ document.querySelectorAll('.gb-pop').forEach(function(e){ e.remove(); }); };
  document.addEventListener('click', function(e){ if (!e.target.closest('.gb-pop') && !e.target.closest('#' + ID)) closePops(); }, true);
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closePops(); });
  // ---------- 分支弹层（列表+搜索+切换+图谱入口）----------
  var branchPop = async function(){
    var btn = document.getElementById(ID + '-branch');
    var p = openPop(btn, ID + '-bp', 340);
    p.innerHTML = '<div style="opacity:.6;padding:2px 0 6px">加载分支…</div>';
    var list = await loadBranches();
    var cur = st.branch;
    var h = '<input id="' + ID + '-q" placeholder="过滤分支…" style="width:100%;box-sizing:border-box;background:rgba(0,0,0,.25);border:1px solid rgba(168,200,232,.25);border-radius:6px;color:inherit;padding:4px 8px;font:inherit;margin-bottom:6px">' +
      '<div style="font-weight:600;margin-bottom:4px">分支 (' + list.length + ')</div><div id="' + ID + '-rows"></div>' +
      '<div style="border-top:1px solid rgba(168,200,232,.2);margin-top:8px;padding-top:8px;display:flex;gap:6px"><button id="' + ID + '-g" style="flex:1;' + BTN() + '">📊 提交图谱</button></div>';
    p.innerHTML = h;
    var rows = document.getElementById(ID + '-rows');
    var render = function(q){
      q = (q || '').toLowerCase();
      rows.innerHTML = '';
      list.filter(function(n){ return !q || n.toLowerCase().indexOf(q) > -1; }).slice(0, 50).forEach(function(n){
        var d = document.createElement('div');
        d.className = 'gb-row' + (n === cur ? ' gb-cur' : '');
        d.innerHTML = '<span style="opacity:.7">' + (n === cur ? '●' : '○') + '</span><span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + n + '</span>' + (n !== cur ? '<span class="gb-sw" style="opacity:0;font-size:11px">切换</span>' : '<span style="opacity:.6;font-size:11px">当前</span>');
        d.onmouseenter = function(){ var s = d.querySelector('.gb-sw'); if (s) s.style.opacity = '.8'; };
        d.onmouseleave = function(){ var s = d.querySelector('.gb-sw'); if (s) s.style.opacity = '0'; };
        d.onclick = n === cur ? null : async function(){
          d.style.opacity = '.5';
          var host = findHost();
          var done = false;
          if (host) { try { var r = await fetch(host + '/git/switch', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ branch: n, path: st.cwd }) }); done = r.ok; } catch (e) {} }
          if (!done) { d.title = '切换需图谱插件 host（未发现）'; d.style.opacity = '1'; return; }
          await refresh(); closePops();
        };
        rows.appendChild(d);
      });
      if (!rows.children.length) rows.innerHTML = '<div style="opacity:.5;padding:6px">无匹配分支</div>';
    };
    render('');
    document.getElementById(ID + '-q').oninput = function(){ render(this.value); };
    document.getElementById(ID + '-g').onclick = graphPop;
  };
  // ---------- 图谱弹层 ----------
  var graphPop = async function(){
    var btn = document.getElementById(ID + '-branch');
    var p = openPop(btn, ID + '-gp', 560);
    p.innerHTML = '<div style="opacity:.6">图谱加载中…</div>';
    var host = findHost();
    var g = null;
    if (host) { try { g = await JJ(await fetch(host + '/git/graph')); } catch (e) {} }
    var items = g && (g.commits || g.nodes || g.graph) || [];
    if (!Array.isArray(items) || !items.length) {
      p.innerHTML = '<div style="opacity:.6;white-space:pre-wrap;font-size:11.5px;line-height:1.6">' + (g ? JSON.stringify(g, null, 1).slice(0, 800) : '图谱数据端点未发现（插件 host 不可达）。\n分支与提交功能不受影响。') + '</div>';
      return;
    }
    var COLS = ['#4c8dff', '#37c871', '#f5a623', '#b57bff', '#ff6b8a'];
    var h = '<div style="font-weight:600;margin-bottom:6px">提交图谱 (' + items.length + ')</div><svg width="100%" height="' + Math.min(items.length * 22 + 8, 500) + '">' +
      '<defs></defs>';
    items.slice(0, 120).forEach(function(c, i){
      var lane = i % 5;
      var x = 14 + lane * 16, y = 12 + i * 22;
      var msg = String(c.message || c.subject || c.title || '').slice(0, 58).replace(/[<>&]/g, '');
      var ha = String(c.hash || c.sha || c.id || '').slice(0, 7);
      var refs = String(c.refs || c.branches || '').slice(0, 22).replace(/[<>&]/g, '');
      h += '<line x1="' + x + '" y1="' + (y - 22) + '" x2="' + x + '" y2="' + y + '" stroke="' + COLS[lane] + '" stroke-width="1.5" opacity=".55"/>' +
        '<circle cx="' + x + '" cy="' + y + '" r="4.5" fill="' + COLS[lane] + '"/>' +
        '<text x="' + (x + 12) + '" y="' + (y - 3) + '" fill="currentColor" opacity=".85" font-size="11.5" font-family="monospace">' + ha + ' ' + msg + '</text>' +
        (refs ? '<text x="' + (x + 12) + '" y="' + (y + 8) + '" fill="currentColor" opacity=".5" font-size="10">' + refs + '</text>' : '');
    });
    h += '</svg>';
    p.innerHTML = h;
  };
  // ---------- 提交面板（全功能对齐）----------
  var commitPop = async function(){
    var btn = document.getElementById(ID + '-commit');
    var p = openPop(btn, ID + '-cp', 400);
    p.innerHTML = '<div style="opacity:.6;padding:2px 0">加载中…</div>';
    var list = await loadBranches();
    var cur = st.branch || (list[0] || '');
    var opts = list.map(function(n){ return '<option value="' + n + '"' + (n === cur ? ' selected' : '') + '>' + n + '</option>'; }).join('');
    p.innerHTML =
      '<div style="font-weight:600;margin-bottom:6px">提交到:</div>' +
      '<select id="' + ID + '-br" style="width:100%;box-sizing:border-box;background:rgba(0,0,0,.25);border:1px solid rgba(168,200,232,.25);border-radius:8px;color:inherit;padding:5px 6px;font:inherit;margin-bottom:6px">' + opts + '</select>' +
      '<textarea id="' + ID + '-msg" placeholder="提交信息…" style="width:100%;box-sizing:border-box;height:58px;background:rgba(0,0,0,.25);border:1px solid rgba(168,200,232,.25);border-radius:8px;color:inherit;padding:6px;font:inherit;resize:none"></textarea>' +
      '<label style="display:flex;gap:6px;align-items:center;margin:6px 0"><input type="checkbox" id="' + ID + '-un" checked>包含未暂存改动</label>' +
      '<div style="display:flex;gap:8px"><button id="' + ID + '-ok" style="flex:1;padding:6px;border-radius:8px;border:1px solid rgba(76,141,255,.5);background:rgba(76,141,255,.2);color:inherit;cursor:pointer">提交' + (st.dirty ? ' (' + st.dirty + ')' : '') + '</button>' +
      '<button id="' + ID + '-okp" style="padding:6px 10px;border-radius:8px;border:1px solid rgba(168,200,232,.3);background:transparent;color:inherit;cursor:pointer">提交并推送</button></div>' +
      '<div id="' + ID + '-r" style="margin-top:6px;opacity:.75;font-size:11.5px;min-height:14px"></div>';
    var send = async function(push){
      var msg = (document.getElementById(ID + '-msg').value || '').trim();
      var rr = document.getElementById(ID + '-r');
      var okBtn = document.getElementById(ID + '-ok');
      if (!msg) { rr.textContent = '⚠ 请填写提交信息'; return; }
      rr.textContent = '⏳ 提交中…'; okBtn.disabled = true; okBtn.style.opacity = '.6';
      var body = { cwd: st.cwd, message: msg, includeUnstaged: document.getElementById(ID + '-un').checked, targetBranch: document.getElementById(ID + '-br').value };
      var ok = false, why = '';
      try { var r = await fetch('/api/dsh-git-commit/commit', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }); var j = await JJ(r); ok = r.ok && (!j || j.ok !== false); why = j && (j.error || j.message || ''); } catch (e) { why = String(e && e.message); }
      if (ok && push) { try { rr.textContent = '⏳ 推送中…'; await fetch('/api/dsh-git-commit/push', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ cwd: st.cwd }) }); } catch (e) {} }
      rr.textContent = ok ? (push ? '✓ 已提交并推送' : '✓ 已提交') : ('✗ 失败 ' + String(why).slice(0, 80));
      okBtn.disabled = false; okBtn.style.opacity = '1';
      await refresh();
    };
    document.getElementById(ID + '-ok').onclick = function(){ send(false); };
    document.getElementById(ID + '-okp').onclick = function(){ send(true); };
    document.getElementById(ID + '-msg').addEventListener('keydown', function(e){ if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') send(false); });
  };
  function BTN(){ return 'display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border:1px solid rgba(168,200,232,.25);border-radius:13px;background:var(--dsw-alias-bg-layer-2,#16233f);color:var(--dsw-alias-label-primary,#dfe8f8);font-size:12.5px;cursor:pointer;white-space:nowrap;'; }
  var build = function(){
    var tb = document.querySelector('.dsh-custom-titlebar');
    if (!tb) return false;
    if (document.getElementById(ID)) return true;
    var bar = document.createElement('div'); bar.id = ID;
    bar.style.cssText = 'display:inline-flex;align-items:center;gap:6px;height:28px;margin-left:10px;flex:0 0 auto;';
    var bb = document.createElement('button'); bb.id = ID + '-branch'; bb.title = '分支 · 图谱'; bb.style.cssText = BTN();
    bb.innerHTML = '<span id="' + ID + '-bl">⎇ …</span><span style="opacity:.55;font-size:10px">▾</span>';
    bb.onclick = branchPop;
    var cb = document.createElement('button'); cb.id = ID + '-commit'; cb.title = '提交'; cb.style.cssText = BTN(); cb.textContent = '⎇ 提交';
    cb.onclick = commitPop;
    bar.appendChild(bb); bar.appendChild(cb);
    tb.appendChild(bar);
    return true;
  };
  var boot = function(){ if (build()) { refresh(); loadBranches(); } };
  setInterval(boot, 1500);
  setInterval(refresh, 6000);
  boot();
})();
}

/* patch(restart-cancel-refresh) P42 2026-08-28: Electron 无刷新键——重启对话框「取消」= 清缓存+刷新页面；另接 Cmd/Ctrl+R。
   2026-08-31 修复: 左栏顶部电源钮(@linxin666/dsh-desktop-launcher)弹的是「确认退出/Confirm exit」对话框,
   原正则 /重启|restart/ 恒不命中 → 取消只关弹窗。判定扩为 确认退出|确定要退出|Confirm exit|want to exit。tests/p42-restart-cancel.test.mjs */
(function(){
  var clearing = false;
  var clearCacheReload = function(){
    if (clearing) return;
    clearing = true;
    try { var lbl = document.getElementById('dsh-gitbar'); if (lbl) lbl.title = '刷新中…'; } catch (e) {}
    var hardReload = function(){ try { fetch('/', { cache: 'reload', method: 'GET' }).catch(function(){}); } catch (e) {} setTimeout(function(){ location.reload(); }, 60); };
    var n = 0, need = 0, fin = function(){ n++; if (n >= need) hardReload(); };
    try {
      if (window.caches && caches.keys) {
        need++;
        caches.keys().then(function(ks){
          need += ks.length;
          if (!ks.length) fin();
          ks.forEach(function(k){ caches.delete(k).then(fin, fin); });
        }, fin);
      }
    } catch (e) {}
    try {
      if (navigator.serviceWorker && navigator.serviceWorker.getRegistrations) {
        need++;
        navigator.serviceWorker.getRegistrations().then(function(rs){
          need += rs.length;
          if (!rs.length) fin();
          rs.forEach(function(r){ r.unregister().then(fin, fin); });
        }, fin);
      }
    } catch (e) {}
    if (need === 0) hardReload();
    setTimeout(function(){ if (!clearing) return; try { location.reload(); } catch (e) {} }, 2500);
  };
  window.__p42ClearReload = clearCacheReload;
  /*patch(p42v3-layer-memory) 2026-09-02: 折叠钮旁重启按钮的弹出页容器类名不在任何 closest 集合、
    且「重启」字样落在祖先前 200 字符外 -> 判定恒 false。根治: MutationObserver 记忆含目标文案的
    fixed/absolute 浮层根, 取消点击 contains 即触发(不猜类名)。*/
  var restartLayers = [];
  var layerPend = null;
  var layerScan = function(){
    layerPend = null;
    try {
      var els = document.querySelectorAll('body *');
      for (var i = 0; i < els.length; i++) {
        var el = els[i], cs = '';
        try { cs = window.getComputedStyle(el).position; } catch (e) {}
        if (cs !== 'fixed' && cs !== 'absolute') continue;
        if (!/重启|restart|重新启动|确认退出|确定要退出|Confirm exit|want to exit/i.test((el.textContent || '').slice(0, 800))) continue;
        if (restartLayers.indexOf(el) < 0) { restartLayers.push(el); if (restartLayers.length > 8) restartLayers.shift(); }
      }
    } catch (e) {}
  };
  try {
    var p42mo = new MutationObserver(function(muts){
      var dirty = false;
      for (var i = 0; i < muts.length && !dirty; i++) {
        var ad = muts[i].addedNodes;
        for (var k = 0; k < ad.length; k++) {
          var n = ad[k];
          if (n.nodeType === 1 && /重启|restart|重新启动|确认退出|确定要退出|Confirm exit|want to exit/i.test((n.textContent || '').slice(0, 800))) { dirty = true; break; }
        }
      }
      if (dirty && !layerPend) layerPend = setTimeout(layerScan, 300);
    });
    p42mo.observe(document.body || document.documentElement, { childList: true, subtree: true });
    setTimeout(layerScan, 800);
  } catch (e) {}
  window.addEventListener('keydown', function(e){
    if ((e.metaKey || e.ctrlKey) && (e.key === 'r' || e.key === 'R')) { e.preventDefault(); e.stopPropagation(); clearCacheReload(); }
  }, true);
  document.addEventListener('click', function(e){
    var t = e.target;
    for (var i = 0; i < 6 && t && t !== document; i++, t = t.parentElement) {
      if ((t.tagName === 'BUTTON' || (t.getAttribute && t.getAttribute('role') === 'button')) ) {
        var txt = (t.textContent || '').trim();
        if (txt === '取消' || txt === 'Cancel' || (t.getAttribute && (t.getAttribute('title') === '取消' || t.getAttribute('aria-label') === '取消' || t.getAttribute('aria-label') === 'Cancel'))) {
          /*patch(p42v3) 2026-09-02: 1)浮层记忆优先(不猜类名) 2)容器文本窗口800 3)祖先兜底12层x800 4)title/aria-label取消锚点*/
          for (var li = 0; li < restartLayers.length; li++) {
            var lay = restartLayers[li];
            if (lay && lay.isConnected && lay.contains(t)) { clearCacheReload(); return; }
          }
          var dlg = t.closest('dialog, [role="dialog"], [class*="dialog"], [class*="Dialog"], [class*="modal"], [class*="Modal"], [class*="overlay"], [class*="Overlay"], [class*="menu"], [class*="Menu"], [class*="dropdown"], [class*="Dropdown"], [class*="popover"], [class*="Popover"], [class*="popper"], [data-radix-popper-content-wrapper], [class*="sheet"], [class*="Sheet"], [class*="drawer"], [class*="Drawer"], [class*="flyout"]');
          if (dlg && /重启|restart|重新启动|确认退出|确定要退出|Confirm exit|want to exit/i.test((dlg.textContent || '').slice(0, 800))) { clearCacheReload(); return; }
          var host = t.closest('[class*="restart"], [id*="restart"], [data-dsh-part*="restart"]');
          if (host) { clearCacheReload(); return; }
          var anc = t.parentElement, hitRestart = false;
          for (var ai = 0; ai < 12 && anc && anc !== document; ai++, anc = anc.parentElement) {
            if (/重启|restart/i.test((anc.textContent || '').slice(0, 800))) { hitRestart = true; break; }
          }
          if (hitRestart) { clearCacheReload(); }
        }
        return;
      }
    }
  }, true);
})();

/* ModuleLoader 契约：封存体外空注册（factory 必须返回带 .apply 的对象），否则 "loaded without registering" */
try { window.__ModuleLoader__.load({ id: "dsh-git-commit", factory: function () { return { apply: function () {} }; } }); } catch (e) { /* already registered by a previous boot pass */ }
/* patch(gitbar-v2) 2026-08-28 干净重写 */
(function(){
  var ID = 'dsh-gitbar';
  var esc = function(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(m){ return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m]; }); };
  var st = { cwd: '', branch: '', gbr: '', dirty: 0, add: 0, del: 0, branches: [], fp: '' };

  // ===== 样式 =====
  var css = document.createElement('style');
  css.textContent = '#' + ID + '{-webkit-app-region:no-drag;pointer-events:auto;background:transparent;border:none;display:inline-flex;align-items:center;color:inherit}';
  css.textContent += '.gb-pop{position:fixed;z-index:2147483002;background:var(--dsw-alias-bg-layer-2,rgba(16,26,48,.88));backdrop-filter:blur(12px);border:1px solid var(--dsw-alias-border-l2,rgba(168,200,232,.25));border-radius:10px;box-shadow:0 12px 32px rgba(0,0,0,.45);font-size:var(--dsw-alias-font-size-sm,12.5px);color:var(--dsw-alias-label-primary,inherit);padding:12px;width:520px;max-height:80vh;overflow:auto}';
  css.textContent += '.gb-row{display:flex;gap:8px;align-items:center;padding:4px 8px;border-radius:6px;cursor:pointer}.gb-row:hover{background:var(--dsw-alias-interactive-bg-hover,rgba(76,141,255,.14))}.gb-cur{background:var(--dsw-alias-brand-primary-bg,rgba(76,141,255,.22))}';
  css.textContent += '.gb-btn{display:inline-flex;align-items:center;gap:4px;height:auto;padding:0 6px;border:none;border-radius:0;background:transparent;color:inherit;font-size:inherit;font-family:inherit;line-height:inherit;cursor:pointer;white-space:nowrap}';
  css.textContent += '.gb-tab{flex:1;padding:5px 0;text-align:center;border-bottom:2px solid transparent;cursor:pointer;color:var(--dsw-alias-label-secondary,inherit)}.gb-tab.on{border-color:var(--dsw-alias-brand-primary,inherit);color:inherit}';
  // P46：legacy chip 隐藏规则迁入（原 v3-final hide 样式 + P44 cssRoute 同款）——
  // 旧分支 chip / 提交 chip / 其停靠行全部退场，git 状态只走本单按钮。
  css.textContent += '#dsh-git-commit-chip{display:none!important}[data-gitgraph-chip-anchor]{display:none!important}[data-gitgraph-chip]{display:none!important}[class*="chipWrap"]{display:none!important}#dshc-goal-git-row{display:none!important}';
  document.head.appendChild(css);

  // ===== 数据 =====
  var J = function(r){ return r.json().catch(function(){ return null; }); };
  var TO = function(ms){ try { return { signal: AbortSignal.timeout(ms || 6000) }; } catch (e) { return {}; } };
  var API = function(p, cwd, extra) { return fetch('/api/dsh-git-commit/' + p + '?cwd=' + encodeURIComponent(cwd) + (extra || ''), TO(8000)).then(J); };

  var selId = function(){
    var sel = document.querySelector('[role="treeitem"][aria-selected="true"]');
    if (!sel) return null;
    for (var k in sel) { if (k.indexOf('__reactFiber') === 0) {
      var f = sel[k];
      for (var i = 0; i < 8 && f; i++) {
        var p = f.memoizedProps;
        if (p && p.node && p.node.id) return String(p.node.id);
        f = f.return;
      }
    }}
    return null;
  };

  var resolveCwd = async function(){
    // 1) RPC session.list
    try {
      var r = await fetch('/api/session.list', Object.assign({ method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ type: 'client-request', rpcId: 'gb-' + Date.now(), method: 'session.list', payload: {} }) }, TO(5000)));
      var j = await J(r);
      var items = j && j.result && j.result.value && j.result.value.items;
      if (Array.isArray(items) && items.length) {
        var sid = selId();
        for (var i = 0; i < items.length; i++) {
          if (sid && String(items[i].sessionId) === sid && items[i].cwd) return items[i].cwd;
        }
        // 无 sid 匹配则取第一个 running 的
        for (var k = 0; k < items.length; k++) { if (items[k].running && items[k].cwd) return items[k].cwd; }
        // 再不行取第一个有 cwd 的
        for (var m = 0; m < items.length; m++) { if (items[m].cwd) return items[m].cwd; }
      }
    } catch (e) {}
    // 2) 种子
// 无会话来源时宁可显示「未定位到工作区」也不静默绑定一个猜测的仓库。
    return null;
  };

  var refresh = async function(){
    var sid = selId();
    var fp = sid || 'default';
    if (fp !== st.fp) { st.fp = fp; st.cwd = ''; st.branch = ''; st.gbr = ''; st.dirty = 0; st.add = 0; st.del = 0; st.branches = []; }
    if (!st.cwd) {
      var nc = await resolveCwd();
      if (!nc) return;
      st.cwd = nc;
    }
    try {
      var sv = await API('status', st.cwd);
      if (sv && sv.ok && sv.status) {
        st.branch = sv.status.branch || '';
        var sg = sv.status.staged || {}, us = sv.status.unstaged || {};
        st.add = (sg.add || 0) + (us.add || 0);
        st.del = (sg.del || 0) + (us.del || 0);
        st.dirty = (sg.n || 0) + (us.n || 0) + (sv.status.untracked || 0);
      }
    } catch (e) {}
    var bl = document.getElementById(ID + '-bl');
    if (bl) {
      var t = '⎇ ' + (st.branch || '…');
      if (st.add || st.del) t += ' +' + st.add + ' -' + st.del;
      if (bl.textContent !== t) bl.textContent = t;
    }
  };

  // ===== 弹层 =====
  var pop = null;
  var closePop = function(){ if (pop) { pop.remove(); pop = null; } };
  document.addEventListener('click', function(e){ if (pop && !e.target.closest('.gb-pop') && !e.target.closest('#' + ID)) closePop(); }, true);
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closePop(); });

  // ===== 图谱渲染（按分支） =====
  var COLS = ['#4c8dff', '#37c871', '#f5a623', '#b57bff', '#ff6b8a'];
  var buildSvg = function(commits, cur) {
    var rowH = 26;
    var s = '<div style="overflow:auto;max-height:52vh;border:1px solid rgba(168,200,232,.15);border-radius:8px">';
    s += '<svg width="680" height="' + (commits.length * rowH + 8) + '" style="display:block">';
    var idxOf = {}; commits.forEach(function(c, i){ idxOf[c.oid] = i; });
    commits.forEach(function(c, i) {
      var x = 16, y = 12 + i * rowH;
      var refs = String(c.refs || '');
      var isCur = (cur && refs.indexOf(cur) > -1) || refs.indexOf('HEAD') > -1;
      (c.parents || []).forEach(function(p) {
        var pj = idxOf[p];
        if (pj === undefined) return;
        s += '<line x1="' + x + '" y1="' + y + '" x2="16" y2="' + (12 + pj * rowH) + '" stroke="' + COLS[i % 5] + '" stroke-width="1.2" opacity=".4"/>';
      });
      s += '<circle cx="' + x + '" cy="' + y + '" r="' + (isCur ? 5 : 4) + '" fill="' + (isCur ? '#4c8dff' : COLS[i % 5]) + '"/>';
      var ha = (c.oid || '').slice(0, 7);
      var au = String(c.author || '').replace(/[<>&]/g, '');
      var dt = c.at ? new Date(c.at * 1000).toLocaleString('zh-CN', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false }) : '';
      var sub = String(c.subject || '').replace(/[<>&]/g, '').slice(0, 52);
      var rf = refs.replace(/[<>&]/g, '').replace('HEAD -> ', '★').split(',').slice(0, 2).join(',');
      s += '<text x="30" y="' + (y + 4) + '" fill="currentColor" opacity="' + (isCur ? 1 : .75) + '" font-size="11" font-family="monospace" font-weight="' + (isCur ? 700 : 400) + '">' + ha + ' ' + au + ' ' + dt + (rf ? ' [' + rf + ']' : '') + '</text>';
      s += '<text x="30" y="' + (y + 16) + '" fill="currentColor" opacity=".55" font-size="10.5">' + sub + '</text>';
    });
    s += '</svg></div>';
    return s;
  };
  var renderGraph = async function(gb) {
    if (!pop) return;
    var box = pop.querySelector('#gb-graph');
    if (!box) return;
    box.innerHTML = '<div style="opacity:.55;padding:8px">⏳ 加载中…</div>';
    var gj2 = null;
    try { gj2 = await API('graph', st.cwd, '&limit=200' + (gb ? '&branch=' + encodeURIComponent(gb) : '')); } catch (e) {}
    var cs = gj2 && gj2.ok && Array.isArray(gj2.commits) ? gj2.commits : [];
    box.innerHTML = cs.length ? buildSvg(cs, gb) : '<div style="opacity:.55;padding:8px">暂无提交数据' + (gj2 && gj2.error ? ' · ' + esc(gj2.error) : '') + '</div>';
  };


  var openPop = function(preferTab){
    closePop();
    var btn = document.getElementById(ID + '-btn');
    if (!btn) return;
    var r0 = btn.getBoundingClientRect();
    pop = document.createElement('div');
    pop.className = 'gb-pop';
    pop.style.left = Math.max(8, Math.min(window.innerWidth - 540, Math.round(r0.left))) + 'px';
    pop.style.top = Math.round(r0.bottom + 6) + 'px';
    pop.innerHTML = '<div style="opacity:.6;padding:4px 2px">⏳ 加载中…</div>';
    document.body.appendChild(pop);
    fillPop(preferTab);
  };

  var fillPop = async function(preferTab){
    var my = pop;
    if (!st.cwd) await refresh();
    if (!pop || pop !== my) return;
    if (!st.cwd) { pop.innerHTML = '<div style="opacity:.6;padding:4px 2px">✗ 未定位到工作区（无会话 cwd）</div>'; return; }
    // 并行取分支+图谱（图谱默认跟随工作分支）
    if (!st.gbr) st.gbr = st.branch || '';
    var bPromise = API('branches', st.cwd);
    var gPromise = API('graph', st.cwd, '&limit=200' + (st.gbr ? '&branch=' + encodeURIComponent(st.gbr) : ''));
    var bj = null;
    try { bj = await bPromise; } catch (e) { console.error('[gitbar] branches fetch error:', e); }
    var gj = null;
    try { gj = await gPromise; } catch (e) { console.error('[gitbar] graph fetch error:', e); }
    if (!pop || pop !== my) return;
    var brs = bj && bj.ok && Array.isArray(bj.branches) ? bj.branches : [];
    var commits = gj && gj.ok && Array.isArray(gj.commits) ? gj.commits : [];
    st.branches = brs;

    // 页签
    var h = '<div style="display:flex;gap:4px;margin-bottom:10px;border-bottom:1px solid rgba(168,200,232,.2)">';
    h += '<div class="gb-tab on" data-t="b">分支(' + brs.length + ')</div>';
    h += '<div class="gb-tab" data-t="g">图谱(' + commits.length + ')</div>';
    h += '<div class="gb-tab" data-t="c">提交</div></div>';

    // 分支页
    h += '<div data-p="b"><input placeholder="过滤…" style="width:100%;background:rgba(0,0,0,.25);border:1px solid rgba(168,200,232,.25);border-radius:6px;color:inherit;padding:4px 8px;font:inherit;margin-bottom:6px"><div id="gb-rows"></div></div>';

    // 图谱页（按分支的提交 DAG：默认工作分支，下拉即切）
    h += '<div data-p="g" style="display:none">';
    h += '<div style="display:flex;gap:6px;align-items:center;margin-bottom:6px"><span style="opacity:.6;font-size:11.5px;flex:0 0 auto">分支</span>';
    h += '<select id="gb-gbr" style="flex:1;background:rgba(0,0,0,.25);border:1px solid rgba(168,200,232,.25);border-radius:6px;color:inherit;padding:3px 6px;font:inherit">' + brs.map(function(bn){ return '<option' + (bn === st.gbr ? ' selected' : '') + '>' + esc(bn) + '</option>'; }).join('') + '</select></div>';
    h += '<div id="gb-graph">' + (commits.length ? buildSvg(commits, st.gbr || st.branch) : '<div style="opacity:.55;padding:8px">暂无提交数据' + (gj && gj.error ? ' · ' + esc(gj.error) : '') + '</div>') + '</div>';
    h += '</div>';

    // 提交页
    h += '<div data-p="c" style="display:none">';
    h += '<select id="gb-br" style="width:100%;background:rgba(0,0,0,.25);border:1px solid rgba(168,200,232,.25);border-radius:8px;color:inherit;padding:5px;font:inherit;margin-bottom:8px">' + brs.map(function(bn){ return '<option' + (bn === st.branch ? ' selected' : '') + '>' + esc(bn) + '</option>'; }).join('') + '</select>';
    h += '<textarea id="gb-msg" placeholder="提交信息（留空自动生成）…" style="width:100%;box-sizing:border-box;height:54px;background:rgba(0,0,0,.25);border:1px solid rgba(168,200,232,.25);border-radius:8px;color:inherit;padding:8px;font:inherit;resize:none"></textarea>';
    h += '<label style="display:flex;gap:6px;align-items:center;margin:6px 0"><input type="checkbox" id="gb-un" checked>包含未暂存</label>';
    h += '<button id="gb-ok" class="gb-btn" style="width:100%;justify-content:center;height:30px;border-radius:8px;border-color:rgba(76,141,255,.55);background:rgba(76,141,255,.22)">⌘↵ 提交' + (st.dirty ? '（' + st.dirty + '）' : '') + '</button>';
    h += '<div style="display:flex;gap:8px;margin-top:8px"><button id="gb-okp" class="gb-btn" style="flex:1;justify-content:center">提交并推送</button><button id="gb-pu" class="gb-btn" style="flex:1;justify-content:center">仅推送</button></div>';
    h += '<div id="gb-r" style="margin-top:6px;opacity:.7;font-size:11.5px;min-height:14px"></div></div>';

    pop.innerHTML = h;
    document.body.appendChild(pop);

    // 图谱分支下拉：切分支即重绘图谱
    var gsel = pop.querySelector('#gb-gbr');
    if (gsel) gsel.onchange = function(){ st.gbr = this.value; renderGraph(st.gbr); };

    // 指定页签打开（分支切换成功后跳图谱用）
    if (preferTab) { var t0 = pop.querySelector('.gb-tab[data-t="' + preferTab + '"]'); if (t0 && t0.onclick) t0.onclick.call(t0); }

    // 页签切换
    pop.querySelectorAll('.gb-tab').forEach(function(t) {
      t.onclick = function() {
        pop.querySelectorAll('.gb-tab').forEach(function(x){ x.style.borderBottomColor = 'transparent'; x.style.color = '#a5b3da'; });
        t.style.borderBottomColor = '#4c8dff'; t.style.color = '';
        pop.querySelectorAll('[data-p]').forEach(function(p){ p.style.display = p.getAttribute('data-p') === t.getAttribute('data-t') ? '' : 'none'; });
      };
    });

    // 分支行
    var rows = pop.querySelector('#gb-rows');
    var renderRows = function(q) {
      rows.innerHTML = '';
      (q ? brs.filter(function(b){ return b.toLowerCase().indexOf(q.toLowerCase()) > -1; }) : brs).forEach(function(bn) {
        var d = document.createElement('div');
        d.className = 'gb-row' + (bn === st.branch ? ' gb-cur' : '');
        d.textContent = (bn === st.branch ? '● ' : '○ ') + bn;
        if (bn !== st.branch) {
          d.title = "点击切换到 " + bn;
          d.onclick = async function(){
            d.style.opacity = ".5";
            try {
              var sr = await fetch("/api/dsh-git-commit/switch", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ cwd: st.cwd, branch: bn }) });
              var sj = await J(sr);
              if (sj && sj.ok) {
                st.branch = bn; st.gbr = bn; refresh();
                renderRows(inp ? inp.value : '');
                if (gsel) gsel.value = bn;
                var tg = pop.querySelector('.gb-tab[data-t="g"]');
                if (tg && tg.onclick) tg.onclick.call(tg);
                renderGraph(bn);
              }
              else { d.style.opacity = "1"; d.title = (sj && sj.error) || "切换失败"; }
            } catch (e) { d.style.opacity = "1"; d.title = e.message; }
          };
        }
        rows.appendChild(d);
      });
    };
    renderRows('');
    var inp = pop.querySelector('input');
    if (inp) inp.oninput = function(){ renderRows(this.value); };

    // 提交
    var doCommit = async function(push) {
      var rr = pop.querySelector('#gb-r');
      rr.textContent = '⏳…';
      try {
        var cr = await fetch('/api/dsh-git-commit/commit', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ cwd: st.cwd, message: pop.querySelector('#gb-msg').value.trim(), includeUnstaged: pop.querySelector('#gb-un').checked, targetBranch: pop.querySelector('#gb-br').value }) });
        var cj = await J(cr);
        if (cj.ok && push) {
          var pr6 = await fetch('/api/dsh-git-commit/push', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ cwd: st.cwd }) });
          rr.textContent = pr6.ok ? '✓ 已提交并推送' : '✗ 已提交，推送失败(HTTP ' + pr6.status + ')';
        }
        else if (cj.ok) rr.textContent = '✓ 已提交';
        else rr.textContent = '✗ ' + (cj.error || '失败');
      } catch (e) { rr.textContent = '✗ ' + e.message; }
      refresh();
    };
    pop.querySelector('#gb-ok').onclick = function(){ doCommit(false); };
    pop.querySelector('#gb-okp').onclick = function(){ doCommit(true); };
    pop.querySelector('#gb-pu').onclick = async function() {
      pop.querySelector('#gb-r').textContent = '⏳ 推送中…';
      try { var pr = await fetch('/api/dsh-git-commit/push', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ cwd: st.cwd }) }); pop.querySelector('#gb-r').textContent = pr.ok ? '✓ 已推送' : '✗ 推送失败'; } catch (e) { pop.querySelector('#gb-r').textContent = '✗ 推送失败: ' + e.message; }
    };
  };

  // ===== 按钮（挂进会话名称那一行的 tablist：排在最后一个标签后，与标签同排同款，无外框） =====
  // 发现逻辑对齐 dsh-web-ui-all stampSemanticParts：conversation pane → header → 直接子 [role=tablist]
  var findTablist = function(){
    var tl = document.querySelector('[data-dsh-responsive-part="session-tablist"]');
    if (tl) return tl;
    // rc.2 fallback: the session tablist carrying the Conversation/Track tabs
    var tls = document.querySelectorAll('[role=tablist]');
    for (var ti = 0; ti < tls.length; ti++) {
      if (/轨迹|对话|Timeline|Chat/.test(tls[ti].textContent || '')) return tls[ti];
    }
    var conv = document.querySelector('[data-pane="conversation"]');
    if (!conv) return null;
    var slot = conv.querySelector('[data-slot="conversation.session.header"]');
    var hd = slot ? slot.querySelector(':scope > header') : null;
    if (!hd) {
      var sp = conv.querySelector('[data-conversation-scroll]');
      var sib = sp ? sp.previousElementSibling : null;
      if (sib && sib.tagName === 'HEADER' && sib.parentElement === sp.parentElement) hd = sib;
    }
    return hd ? hd.querySelector(':scope > [role="tablist"]') : null;
  };
  var findTabRow = function() {
    // 找第一行放标签的容器（nav/crumbs/tablist 的父级，或直接是容器本身）
    var navs = document.querySelectorAll('nav,[role=tablist],[class*="crumbs"]');
    for (var i = 0; i < navs.length; i++) {
      var r = navs[i].getBoundingClientRect();
      if (r.y >= 0 && r.y < 120 && r.width > 100) {
        // 返回这个容器（标签直接放在里面）
        return navs[i];
      }
    }
    // 兜底：找有文字标签的第一行 flex 容器
    var spans = document.querySelectorAll('span,div');
    for (var j = 0; j < spans.length; j++) {
      var sr = spans[j].getBoundingClientRect();
      if (sr.y >= 0 && sr.y < 120 && sr.width > 200 && sr.height > 15 && sr.height < 40) {
        if (spans[j].children.length >= 1 && (spans[j].children[0].textContent || '').trim()) {
          return spans[j];
        }
      }
    }
    return null;
  };
  var ensure = function(){
    var bar = document.getElementById(ID);
    if (!bar) {
      bar = document.createElement('span'); bar.id = ID;
      var btn = document.createElement('button');
      btn.id = ID + '-btn';
      btn.type = 'button';
      btn.style.cssText = 'display:inline-flex;align-items:center;gap:2px;padding:0 4px;border:none;background:transparent;cursor:pointer;white-space:nowrap;font-size:inherit;line-height:inherit;color:inherit;font-family:inherit;font-weight:inherit;';
      btn.innerHTML = '<span id="' + ID + '-bl">⎇ …</span><span style="opacity:.5;font-size:.8em">▾</span>';
      btn.onclick = openPop;
      bar.appendChild(btn);
    }
    if (bar.parentElement !== document.body) document.body.appendChild(bar);
    // P46 2026-08-30：锚「轨迹」所在 tab 行——语义 tablist 优先（findTablist，
    // 与 dsh-web-ui-all stampSemanticParts 同源），findTabRow 兜底。旧版扫
    // y<36 首行文字元素：自定义标题栏(32px)把 tab 行压到 y≈48 后永远锚不
    // 中，bar 漂离轨迹。现取行内可见子元素的实测最右缘，钉其后同排同高。
    var row = findTablist() || findTabRow();
    if (!row) { bar.style.visibility = 'hidden'; return; }
    var cands = row.querySelectorAll('[role=tab],[role=tablist]>*');
    var last = null;
    for (var i = 0; i < cands.length; i++) {
      if (cands[i].closest('#' + ID)) continue;
      var r = cands[i].getBoundingClientRect();
      if (r.width <= 0 || r.height < 8 || r.height > 44) continue;
      if (!last || r.right > last.right) last = { right: r.right, y: r.y, h: r.height, el: cands[i] };
    }
    if (!last) { bar.style.visibility = 'hidden'; return; }
    var left = Math.round(last.right + 6);
    var top = Math.round(last.y);
    var h = Math.round(last.h);
    // 写样式：z-index:1（可见但低于弹层）
    bar.style.cssText = 'position:fixed;left:' + left + 'px;top:' + top + 'px;height:' + h + 'px;display:inline-flex;align-items:center;flex:0 0 auto;margin:0;z-index:1;';
    // 字体
    var ref = last.el;
    // 找标签内最深的纯文字元素（叶子节点）
    var leaves = ref.querySelectorAll('*');
    for (var li = 0; li < leaves.length; li++) {
      if (leaves[li].textContent.trim() && !leaves[li].children.length) { ref = leaves[li]; break; }
    }
    var ls = getComputedStyle(ref);
    bar.style.color = ls.color;
    bar.style.fontSize = ls.fontSize;
    bar.style.fontFamily = ls.fontFamily;
    bar.style.fontWeight = ls.fontWeight;
    var bEl = bar.querySelector('button');
      if (bEl) {
        bEl.style.fontSize = ls.fontSize;
        bEl.style.lineHeight = ls.lineHeight;
        bEl.style.color = ls.color;
        bEl.style.fontFamily = ls.fontFamily;
        bEl.style.fontWeight = ls.fontWeight;
      }
      var sEl = bar.querySelector('#' + ID + '-bl');
      if (sEl) { sEl.style.fontSize = ls.fontSize; sEl.style.lineHeight = ls.lineHeight; }
      var aEl = bar.querySelector('span:last-child');
      if (aEl) { aEl.style.fontSize = ls.fontSize; aEl.style.lineHeight = ls.lineHeight; }
  };
/* patch(gitbar-tab-mount) 2026-08-31: 旧 fixed 几何链停用——ensure 把 bar 钉到发送按钮附近且与
     tablist 直挂方案互相抢夺 bar; refresh 也停用(与 launcher 的标签刷新双写打架)。全部由文件尾 launcher 独占。 */
})();


/* patch(p42-restart-cancel-refresh) 2026-08-28 */
(function(){
  var clearing = false;
  var clearCacheReload = function(){
    if (clearing) return;
    clearing = true;
    var hard = function(){ try { fetch('/', { cache: 'reload' }); } catch (e) {} setTimeout(function(){ location.reload(); }, 60); };
    var n = 0, need = 0, fin = function(){ n++; if (n >= need) hard(); };
    try { if (window.caches && caches.keys) { need++; caches.keys().then(function(ks){ need += ks.length; if (!ks.length) fin(); ks.forEach(function(k){ caches.delete(k).then(fin, fin); }); }, fin); } } catch (e) {}
    try { if (navigator.serviceWorker && navigator.serviceWorker.getRegistrations) { need++; navigator.serviceWorker.getRegistrations().then(function(rs){ need += rs.length; if (!rs.length) fin(); rs.forEach(function(r){ r.unregister().then(fin, fin); }); }, fin); } } catch (e) {}
    if (need === 0) hard();
    setTimeout(function(){ try { location.reload(); } catch (e) {} }, 2500);
  };
  window.__p42ClearReload = clearCacheReload;
  window.addEventListener('keydown', function(e){ if ((e.metaKey || e.ctrlKey) && (e.key === 'r' || e.key === 'R')) { e.preventDefault(); e.stopPropagation(); clearCacheReload(); } }, true);
  document.addEventListener('click', function(e){
    var t = e.target;
    for (var i = 0; i < 6 && t && t !== document; i++, t = t.parentElement) {
      if (t.tagName === 'BUTTON' || (t.getAttribute && t.getAttribute('role') === 'button')) {
        var txt = (t.textContent || '').trim() || (t.title || '').trim();
        if (txt === '取消' || txt === 'Cancel') {
          var dlg = t.closest('[role="dialog"], dialog, [class*="dialog" i], [class*="modal" i], [class*="overlay" i], [class*="restart" i]');
          if (dlg && /重启|restart|确认退出|确定要退出|Confirm exit|want to exit/i.test(dlg.textContent || '')) clearCacheReload();
        }
        return;
      }
    }
  }, true);
})();

