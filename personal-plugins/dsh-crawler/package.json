{
  "name": "dsh-crawler",
  "version": "0.5.0",
  "description": "通用网页爬虫 pawl：http/crawl4ai/反检测浏览器三引擎；单页自由提取(文字/图片/表格/PDF/电子书)、批量断点续爬、整站BFS、CF自动过验证。侧边栏「爬虫」卡全量设置(网页列表/检索词模糊匹配/存放格式/存储路径)，6 个 agent 工具。",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "crawler",
    "scraper",
    "patchright",
    "crawl4ai",
    "cloudflare"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
